NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-18

# Newsletter (MailerLite). Server-side only — never prefix with NEXT_PUBLIC.
# Create an API token at MailerLite → Integrations → API, and (optionally) a
# group to add subscribers to (MailerLite → Subscribers → Groups).
MAILERLITE_API_KEY=your_mailerlite_api_token
MAILERLITE_GROUP_ID=optional_group_id
# Used only when MAILERLITE_API_KEY is unset, so signups are still captured.
NEWSLETTER_FALLBACK_ENDPOINT=your_formspree_endpoint_url

# Contact form Formspree endpoint (server-side only — never expose to browser)
FORMSPREE_CONTACT_ENDPOINT=your_formspree_endpoint_url

